# 環境変数（設計 §22）
# このファイルは雛形。実キーを書き込まない。実値は .env.local に置く（.gitignore 済み）。
# すべて server-only module（infrastructure/config/env.ts）から読む。
#
# NEXT_PUBLIC_ で始まる環境変数は、この方式では絶対に使わない。
# Next.js は NEXT_PUBLIC_ の付いた値をビルド時に client bundle へ埋め込むため、
# OPENAI_API_KEY のような秘密情報はもちろん、上限値や provider 名なども
# ブラウザから読めてしまう。設定はすべてサーバ側で解決し、
# client には API のレスポンス（設計 §14.2）としてのみ渡す。
# この規約は CLAUDE.md の禁止事項、設計 §12.1 / §19 に対応する。
# 逸脱の検知は tests/unit/no-next-public.test.ts が行う（app / components / domain /
# application / infrastructure / schemas を走査対象とする）。

# mock / openai。CI は必ず mock。
AI_PROVIDER=mock

# AI_PROVIDER=openai のときのみ使用する。client bundle・ログへ出さない。
# ここに値を書かない（このファイルはコミットされる）。
OPENAI_API_KEY=

# 未設定なら Mock へ戻す。モデル名はコードに書かず、ここだけで決める。
OPENAI_TEXT_MODEL=

# Mock が読む fixture（content/fixtures/mock-ai/<名前>.json）。
# default = 通常系、no-argument = A1が立論を出さない筋書き（設計 §10）。
MOCK_AI_FIXTURE=default

# memory / postgres
PERSISTENCE_PROVIDER=memory

# realtime / manual（manual は test のみ。production build では使用不可）
CLOCK_MODE=realtime

# rule set の値を上書きする開発用
CX_EXCHANGES_PER_SECTION=3

# AI 1回あたりのタイムアウト（ミリ秒）
AI_RUN_TIMEOUT_MS=30000

# 成功 run の上限
MAX_AI_RUNS_PER_MATCH=40

# 試行回数の上限
MAX_AI_ATTEMPTS_PER_MATCH=90

# 1 run あたりの再試行上限
MAX_AI_RETRIES_PER_RUN=2

# 出力トークン合計の上限
MAX_MATCH_OUTPUT_TOKENS=30000
